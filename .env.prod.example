# Kopyala: cp .env.prod.example .env.prod  — .env.prod git'e girmez.

# Alan adı (Cloudflare'de) ve sertifika e-postası
DOMAIN=cuzdan.ornek.com
ACME_EMAIL=sen@ornek.com
# Cloudflare → My Profile → API Tokens → "Edit zone DNS" şablonu (sadece bu alan adı)
CLOUDFLARE_API_TOKEN=

# Veritabanı (güçlü bir şifre: openssl rand -base64 24)
POSTGRES_USER=wallet
POSTGRES_PASSWORD=
POSTGRES_DB=wallet

APP_TIMEZONE=Europe/Istanbul

# Bildirimler: docker compose -f docker-compose.prod.yml run --rm api gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sen@ornek.com
