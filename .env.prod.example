# Kopyala: cp .env.prod.example .env.prod  — .env.prod git'e girmez.

# Alan adı (Cloudflare'de, A kaydı sunucu IP'sine) ve sertifika e-postası (opsiyonel)
DOMAIN=wallet.ornek.com
# Opsiyonel: API'ye doğrudan erişim için ayrı alan adı (iOS Kestirmesi vb.)
API_DOMAIN=
ACME_EMAIL=

# Veritabanı (güçlü bir şifre: openssl rand -hex 24)
POSTGRES_USER=wallet
POSTGRES_PASSWORD=
POSTGRES_DB=wallet

APP_TIMEZONE=Europe/Istanbul

# Bildirimler: docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm --no-deps api gen-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://wallet.ornek.com
