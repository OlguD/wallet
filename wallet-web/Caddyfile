# Traefik arkasında sadece statik dosya sunucusu (TLS Traefik'te).
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	root * /srv

	# Hash'li dosyalar sonsuza kadar, kabuk dosyaları her seferinde doğrulanarak önbelleklenir.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"
	header -Server

	try_files {path} /index.html
	file_server
}
