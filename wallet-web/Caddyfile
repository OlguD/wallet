{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Sertifika Cloudflare DNS doğrulamasıyla alınır; Cloudflare proxy (turuncu bulut) açıkken de çalışır.
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# API: /api önekini kaldırıp Go sunucusuna aktar. Dekontlar için gövde sınırı.
	handle_path /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# Hash'li dosyalar sonsuza kadar, kabuk dosyaları her seferinde doğrulanarak önbelleklenir.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
